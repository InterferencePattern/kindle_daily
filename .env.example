# Copy this to .env and fill in. Real .env is gitignored.
# On the Pi: chmod 600 .env

# FreshRSS — use the API password from your FreshRSS user profile,
# NOT your normal login password.
FRESHRSS_URL=http://nas.local:8080
FRESHRSS_USER=your_freshrss_username
FRESHRSS_API_PASSWORD=your_freshrss_api_password

# Gmail — must be on Amazon's Send-to-Kindle approved-sender list.
# Use a 16-char app password (https://myaccount.google.com/apppasswords).
KINDLE_DAILY_GMAIL_USER=you@gmail.com
KINDLE_DAILY_GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Your Send-to-Kindle email address.
KINDLE_EMAIL=you_abc123@kindle.com

# Per-issue caps (defaults shown).
MAX_EPUB_MB=15
# Only include articles whose published date is within this many days.
MAX_AGE_DAYS=7

# Comma-separated FreshRSS category/label names to exclude server-side.
# Example: EXCLUDED_CATEGORIES=Comics,Memes
EXCLUDED_CATEGORIES=Comics
